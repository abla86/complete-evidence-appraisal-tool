{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evidence-tool/schemas/source-record.v1.json",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordId", "source", "metadata", "identifiers", "referenceDraft", "legalReference", "privacy", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "recordId": { "type": "string", "pattern": "^[a-z0-9]{8}-[a-z0-9]{4}-4[a-z0-9]{3}-[89ab][a-z0-9]{3}-[a-z0-9]{12}$", "description": "Generated by the receiving application." },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "capturedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "fields", "missingFields", "sourceUrl", "detectedAt", "detectedFrom"],
      "properties": {
        "status": { "enum": ["COMPLETE", "INCOMPLETE", "UNVERIFIABLE"] },
        "fields": {
          "type": "object", "additionalProperties": false,
          "required": [],
          "properties": {
            "title": { "type": ["string", "null"] },
            "journalTitle": { "type": ["string", "null"] },
            "volume": { "type": ["string", "null"] },
            "issue": { "type": ["string", "null"] },
            "firstPage": { "type": ["string", "null"] },
            "lastPage": { "type": ["string", "null"] },
            "publicationDate": { "type": ["string", "null"] },
            "issn": { "type": ["string", "null"] },
            "authors": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sourceUrl": { "type": "string", "format": "uri" },
        "detectedAt": { "type": "string", "format": "date-time" },
        "detectedFrom": { "type": "array", "items": { "enum": ["citation-meta", "open-graph", "schema-org", "document", "manual"] } },
        "missingFields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "identifiers": {
      "type": "object", "additionalProperties": false, "required": ["doi"],
      "properties": {
        "doi": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["normalized", "formatValid"],
          "properties": {
            "normalized": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
            "formatValid": { "type": "boolean", "description": "Local syntax validation only; never online verification." },
            "raw": { "type": "string" },
            "resolverUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "referenceDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["apa7", "status", "note"],
      "properties": {
        "apa7": { "type": ["string", "null"] },
        "status": { "enum": ["complete", "incomplete", "unverifiable"] },
        "note": { "const": "Draft – detected metadata, not verified against source" }
      }
    },
    "legalReference": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["type", "officialId", "shortTitle", "citation"],
      "properties": {
        "type": { "enum": ["lov", "forskrift"] },
        "officialId": { "type": "string" },
        "shortTitle": { "type": "string" },
        "paragraph": { "type": ["string", "null"] },
        "citation": { "type": "string" },
        "lovdataUrl": { "type": "string", "format": "uri" }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["domains", "coverageNote", "localOnly"],
      "properties": {
        "coverageNote": { "type": "string" },
        "localOnly": { "const": true },
        "domains": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["domain", "isThirdParty", "category", "count", "verified"],
            "properties": {
              "domain": { "type": "string" },
              "isThirdParty": { "type": "boolean" },
              "category": { "enum": ["first_party", "external_resource", "tracking_signal"] },
              "count": { "type": "integer", "minimum": 1 },
              "signals": { "type": "array", "items": { "type": "string" } },
              "verified": { "const": false }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "toolVersion", "collectedLocally", "externalRequestsMade", "collectedAt"],
      "properties": {
        "tool": { "type": "string" },
        "toolVersion": { "type": "string" },
        "collectedLocally": { "const": true },
        "externalRequestsMade": { "const": false },
        "collectedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
