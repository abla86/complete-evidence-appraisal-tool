# Local development configuration. Copy to .env and fill in. Never commit a populated .env file.

# --- Required in production ---------------------------------------------------
# Unique random value of at least 32 characters (signs login sessions).
AUTH_SESSION_SECRET=

# --- Licensing (run: npm run license:keygen) ----------------------------------
# Private key: server secret only. Public key: embedded in the app at build time.
LICENSE_PRIVATE_KEY=
VITE_LICENSE_PUBLIC_KEY=
# Set to false only for internal/self-hosted builds that should run without a licence.
VITE_LICENSE_REQUIRED=true
TRIAL_DAYS=7
OFFLINE_LICENSE_SEATS=1

# --- Seller information shown in terms, privacy policy and receipts -------------
VITE_SELLER_EMAIL=
VITE_SELLER_VAT_REGISTERED=false
# Public website (used for purchase links from the downloaded edition).
VITE_PUBLIC_SITE_URL=

# --- Stripe Payment Links -----------------------------------------------------
# Success URL for both links: https://<domain>/purchase-complete?session_id={CHECKOUT_SESSION_ID}
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK_ID_OFFLINE=
STRIPE_PAYMENT_LINK_URL_OFFLINE=
PRICE_LABEL_OFFLINE=
STRIPE_PAYMENT_LINK_ID_ONLINE=
STRIPE_PAYMENT_LINK_URL_ONLINE=
PRICE_LABEL_ONLINE=

# --- Optional: Google sign-in (trial + cloud sync) ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:10000/auth/google/callback
APP_URL=http://localhost:10000

# --- Optional: AI suggestions (off unless the user consents per analysis) -----
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Server data (trial registry, synced records) -----------------------------
# Local filesystem; use a persistent volume and backups in production.
EVIDENCE_DATA_DIR=./data
RESEARCH_ARTIFACTS_DATA_DIR=./data/research-artifacts
