# Copy to .env for local development. Never commit the populated .env file.
# Use a unique, cryptographically random secret of at least 32 characters in production.
AUTH_SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret

# Google OAuth 2.0 — register the exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional; defaults to APP_URL or RENDER_EXTERNAL_URL plus /auth/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
APP_URL=http://localhost:3000

# AI features. Keep this key on the server; never expose it to the browser.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Stripe Pro checkout. The payment link must match the configured product.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRO_PAYMENT_LINK_ID=your-stripe-payment-link-id

# Optional storage directories. Local filesystem data can be lost on ephemeral
# hosting or redeploy; use a supported persistent volume/database before storing
# anything that must survive restarts or deployments.
EVIDENCE_DATA_DIR=./data
RESEARCH_ARTIFACTS_DATA_DIR=./data/research-artifacts
