# Local development configuration. Populate locally; never commit a populated .env file.
# Production AUTH_SESSION_SECRET must be a unique random value of at least 32 characters.
AUTH_SESSION_SECRET=

# Google OAuth 2.0. Register the exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
APP_URL=http://localhost:3000

# AI provider; keep the key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Stripe Pro checkout.
STRIPE_SECRET_KEY=
STRIPE_PRO_PAYMENT_LINK_ID=

# Optional data directories. Local filesystem data may be lost on ephemeral hosting,
# redeploy, or instance replacement. Configure persistent storage before relying on
# server-side records to survive those events.
EVIDENCE_DATA_DIR=./data
RESEARCH_ARTIFACTS_DATA_DIR=./data/research-artifacts
