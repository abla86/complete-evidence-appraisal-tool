{
  "name": "complete-evidence-appraisal-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/services/implementationTrace.test.ts --test-name-pattern=.",
    "test:coverage": "node --import tsx --test --experimental-test-coverage src/services/implementationTrace.test.ts --test-name-pattern=."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.2",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "dompurify": "^3.4.15",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
